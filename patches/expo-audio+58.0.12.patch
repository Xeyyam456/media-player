--- a/node_modules/expo-audio/android/src/main/java/expo/modules/audio/service/AudioControlsService.kt
+++ b/node_modules/expo-audio/android/src/main/java/expo/modules/audio/service/AudioControlsService.kt
@@ -424,8 +424,38 @@ class AudioControlsService : MediaSessionService() {
         if (isLive) {
           commands.remove(Player.COMMAND_SEEK_IN_CURRENT_MEDIA_ITEM)
         }
+        // PATCH (mediaplayer): tək ExoPlayer-də növbəti/əvvəlki element olmur və Media3 bu əmrləri silir.
+        // JS növbəni idarə etdiyi üçün onları məcburi əlavə edib basılanda JS hadisəsinə yönləndiririk.
+        if (playable.supportsNextTrack) {
+          commands.add(Player.COMMAND_SEEK_TO_NEXT)
+          commands.add(Player.COMMAND_SEEK_TO_NEXT_MEDIA_ITEM)
+        }
+        if (playable.supportsPreviousTrack) {
+          commands.add(Player.COMMAND_SEEK_TO_PREVIOUS)
+          commands.add(Player.COMMAND_SEEK_TO_PREVIOUS_MEDIA_ITEM)
+        }
         return commands.build()
       }
+
+      override fun isCommandAvailable(command: Int): Boolean = availableCommands.contains(command)
+
+      override fun hasNextMediaItem(): Boolean = playable.supportsNextTrack || super.hasNextMediaItem()
+
+      override fun seekToNext() {
+        if (playable.supportsNextTrack) playable.nextTrack() else super.seekToNext()
+      }
+
+      override fun seekToNextMediaItem() {
+        if (playable.supportsNextTrack) playable.nextTrack() else super.seekToNextMediaItem()
+      }
+
+      override fun seekToPrevious() {
+        if (playable.supportsPreviousTrack) playable.previousTrack() else super.seekToPrevious()
+      }
+
+      override fun seekToPreviousMediaItem() {
+        if (playable.supportsPreviousTrack) playable.previousTrack() else super.seekToPreviousMediaItem()
+      }
     }
